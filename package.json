{
  "name": "wrapguard",
  "version": "0.3.1",
  "description": "Catch text that starts wrapping onto more lines, before it ships. Line-count snapshots for your pages at every breakpoint.",
  "keywords": [
    "responsive",
    "line-wrap",
    "text-wrap",
    "copy",
    "i18n",
    "playwright",
    "visual-regression",
    "ci"
  ],
  "homepage": "https://github.com/fynepdf/wrapguard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fynepdf/wrapguard.git"
  },
  "bugs": "https://github.com/fynepdf/wrapguard/issues",
  "author": "FynePDF (https://fynepdf.com)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "wrapguard": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
